SET x TO "Hello, World\n"
-- This is a comment
OUTPUT x -- This is also a comment
PS This is a 
multiline comment that spans
many man lines
and keeps going END

OUTPUT "Type your name here: "
INPUT name

PS `TYPE` is optional but can make type conversions
    between different data types, like you can run
        INPUT value
    and `number` will be a type `text` object, or
    you can run
        INPUT value TYPE number
    and it will interpret it as a type `number` object.
    However, it won't interpret "42" as 42, as Brainfine
    can never throw runtime errors. Instead, it takes the
    ASCII Code of the value and returns it as an array.
END

PS
    Types of `TYPE`:
        - symbol = char (ASCII)
        - number = int (unlimited precision OR long)
        - decimal = float (unlimited precision OR double)
        - text = string (regular, unlimited precision)
        - list = array (regular, unlimited precision)
END

PASTE filename -- copies and pastes filename.bfn into this location. like #include in c++
SET message TYPE text TO "Hello, @name!"
SET moreBoringMessage TO "Hello, " + name + "."

OUTPUT message + "\n"

OUTPUT "It is now time to guess a number between 1 and 10: "
INPUT guess -- input always defaults to text 

-- chosen by a fair dice roll. guaranteed to be random
REPLACE answer TYPE text WITH "4" 
-- REPLACE _ (TYPE _) WITH _ is like a `const` declaration instead of a regular var decl

WHILE guess ~= answer DO
    OUTPUT "You were wrong!\n"
    INPUT guess
END
OUTPUT "You guessed right!\n"
PS REPEAT means WHILE true (no BREAK statement in Brainfine means you have to exit with QUIT to 
    quit the program)
END

-- REPEAT OUTPUT "test\n" END
-- ^ commented out becaue otherwise it would be an infinite loop

-- There are also IF and FOR statements:
IF 5 = 5 THEN
    OUTPUT "5 = 5\n"
OTHERWISE IF 6 = 5 THEN
    OUTPUT "6 = 5\n"
OTHERWISE OUTPUT "5 and 6 both do not = 5\n" END

-- Functions/subroutines are called `tasks` and declared like this
TASK SayHi DOES
    OUTPUT "Hello.\n"
END

PS
    TASKs do not compile to `goto`s in the ending Brainf***, but instead, are like a copy and paste
    template, where the code in a task literally replaces a RUN action
END

-- arguments can be passed, too
TASK SayHiToPerson WITH name DOES
    OUTPUT "Hello, @name.\n"
END

-- to call a `task`, use `RUN`
RUN SayHi

-- with args:
RUN SayHiToPerson WITH "Bob"
